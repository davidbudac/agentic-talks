#!/usr/bin/env python3
"""Grade one attempt at an invoice-app task.

Pass means both: the hidden tests for the task pass (hidden/test_<task>.py)
and the repository's own tests still pass (python3 -m unittest).

Two ways to call it:
  * as an smevals Checker: no arguments; reads SMEVALS_RUN_DIR and SMEVALS_TASK
    and grades SMEVALS_RUN_DIR/repo (the copy the runner left behind);
  * by hand:  hidden-tests --repo DIR --task TASK

Prints one JSON object in the smevals Checker format (score, metrics, notes,
details) and exits 0 on pass, 1 on fail. When the runner left metrics.json in
the run directory, its cost, turns and token counts are copied into metrics so
smevals reports can aggregate them.
"""
import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

HIDDEN = Path(__file__).resolve().parent.parent / "hidden"
COPIED_METRICS = ("cost_usd", "num_turns", "total_tokens", "duration_s", "output_tokens",
                  "cache_read_tokens", "cache_creation_tokens", "input_tokens")


def unittest(repo: Path, *args: str) -> dict:
    env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1", "PYTHONPATH": str(repo)}
    try:
        proc = subprocess.run([sys.executable, "-m", "unittest", *args], cwd=repo, env=env,
                              capture_output=True, text=True, timeout=300)
    except subprocess.TimeoutExpired:
        return {"ok": False, "ran": 0, "summary": "timeout", "tail": []}
    ran = re.search(r"Ran (\d+) tests?", proc.stderr)
    lines = proc.stderr.strip().splitlines()
    return {"ok": proc.returncode == 0, "ran": int(ran.group(1)) if ran else 0,
            "summary": lines[-1] if lines else "", "tail": lines[-15:]}


def grade(repo: Path, task: str) -> dict:
    module = f"test_{task.replace('-', '_')}.py"
    if not (HIDDEN / module).is_file():
        raise SystemExit(f"no hidden tests for task {task!r} ({HIDDEN / module})")
    if not (repo / "invoicing").is_dir():
        return {"score": 0.0, "metrics": {"hidden_ok": False, "own_tests_ok": False},
                "notes": f"no invoice-app copy at {repo}", "details": {}}
    hidden = unittest(repo, "discover", "-s", str(HIDDEN), "-p", module, "-t", str(HIDDEN))
    own = unittest(repo)
    passed = hidden["ok"] and own["ok"]
    notes = "pass" if passed else (
        "hidden tests failed: " + hidden["summary"] if not hidden["ok"] else
        "own tests failed: " + own["summary"])
    return {
        "score": 1.0 if passed else 0.0,
        "metrics": {"hidden_ok": hidden["ok"], "own_tests_ok": own["ok"],
                    "own_tests_ran": own["ran"]},
        "notes": notes,
        "details": {"hidden": hidden, "own": own},
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--repo", type=Path)
    parser.add_argument("--task")
    args = parser.parse_args()
    run_dir = Path(os.environ["SMEVALS_RUN_DIR"]) if os.environ.get("SMEVALS_RUN_DIR") else None
    repo = args.repo or (run_dir / "repo" if run_dir else None)
    task = args.task or os.environ.get("SMEVALS_TASK")
    if repo is None or not task:
        parser.error("pass --repo and --task, or run under smevals")
    result = grade(repo.resolve(), task)
    metrics_file = (run_dir or repo.parent) / "metrics.json"
    if metrics_file.is_file():
        try:
            session = json.loads(metrics_file.read_text())
        except ValueError:
            session = {}
        for key in COPIED_METRICS:
            if isinstance(session.get(key), (int, float)):
                result["metrics"][key] = session[key]
    print(json.dumps(result, ensure_ascii=False))
    return 0 if result["score"] == 1.0 else 1


if __name__ == "__main__":
    sys.exit(main())
